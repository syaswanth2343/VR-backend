# Copy these into Railway → your backend service → Variables.
# Replace MYSQL_PASSWORD with the value from Railway → MySQL → Connect (rotate if leaked).

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_MYSQL_HOST:YOUR_PORT/YOUR_DATABASE?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD
